rotation=180;" vertex="1" parent="1"><mxGeometry x="972.0" y="548.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;④ IOfferStorage&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;SQL / JDBC over TLS&lt;br&gt;save / fetch ciphertext&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="786.0" y="482.0" width="220" height="56" as="geometry"/></mxCell><mxCell id="c36" style="endArrow=block;endFill=1;html=1;strokeColor=#C0392B;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="832.0" y="572.8" as="sourcePoint"/><mxPoint x="960.0" y="572.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" style="endArrow=none;html=1;strokeColor=#2F4B7C;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1024" y="288" as="sourcePoint"/><mxPoint x="996.0" y="288.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" style="endArrow=none;html=1;strokeColor=#2F4B7C;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="961.6" y="288.0" as="sourcePoint"/><mxPoint x="768" y="288" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="" style="shape=providedRequiredInterface;html=1;fillColor=#FFFFFF;strokeColor=#2F4B7C;strokeWidth=2;rotation=180;" vertex="1" parent="1"><mxGeometry x="972.0" y="276.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;⑤ INotification&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;SMTP / Email API&lt;br&gt;sendOfferEmail(student, pdf)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="786.0" y="210.0" width="220" height="56" as="geometry"/></mxCell><mxCell id="c41" style="endArrow=block;endFill=1;html=1;strokeColor=#C0392B;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="832.0" y="300.8" as="sourcePoint"/><mxPoint x="960.0" y="300.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="&lt;b&gt;Campus Placement &amp;amp; Internship Pipeline – Microservices Architecture (UML Component Diagram)&lt;/b&gt;" style="text;html=1;align=center;fontSize=16;" vertex="1" parent="1"><mxGeometry x="0" y="-40" width="1312" height="30" as="geometry"/></mxCell><mxCell id="c43" value="Epic 4: Offer Management &amp;amp; Data Security (FR-004, NFR-001)" style="text;html=1;align=center;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="0" y="-12" width="1312" height="24" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Data flow: generating an offer&lt;/b&gt;&lt;br&gt;① Officer marks student &quot;Selected&quot; / confirms&lt;br&gt;② Offer Manager requests letter; PDF returned&lt;br&gt;③ Offer Manager sends PDF for AES-256 encryption&lt;br&gt;④ Encryption Service stores ciphertext in repository&lt;br&gt;⑤ Offer Manager triggers email of PDF to student&lt;br&gt;&lt;br&gt;&lt;b&gt;Notation&lt;/b&gt;: ball = provided interface, socket = required interface; red arrow = direction of request / data flow" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;strokeColor=#888888;fillColor=#FFFFFF;spacing=8;" vertex="1" parent="1"><mxGeometry x="24" y="344" width="416" height="272" as="geometry"/></mxCell><mxCell id="c45" value="Team 003 | Moksha S (PES1UG24AM167) | SE Lab 3 (UE24CS341A)" style="text;html=1;align=center;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="690" width="1312" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
